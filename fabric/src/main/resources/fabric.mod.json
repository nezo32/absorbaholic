{
	"schemaVersion": 1,
	"id": "absorbaholic",
	"version": "${version}",
	"name": "Absorbaholic",
	"description": "Sneak. Absorb. Become. Sneak and use an empty hand on almost any block or mob to absorb it: you gain one of its powers forever, and one of its weaknesses.",
	"authors": ["nezo"],
	"contact": {
		"homepage": "https://github.com/nezo32/absorbaholic",
		"sources": "https://github.com/nezo32/absorbaholic",
		"issues": "https://github.com/nezo32/absorbaholic/issues"
	},
	"license": "MIT",
	"icon": "assets/absorbaholic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.absorbaholic.Absorbaholic"],
		"client": ["dev.absorbaholic.client.AbsorbaholicClient"],
		"modmenu": ["dev.absorbaholic.client.ModMenuIntegration"]
	},
	"mixins": [
		"absorbaholic.mixins.json",
		{ "config": "absorbaholic.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": ">=26.2 <26.4-",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	}
}
